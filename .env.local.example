# =====================================================================
# CONTOH ISI FILE .env.local
# Salin file ini menjadi ".env.local" lalu isi dengan nilai asli
# dari Firebase Console. File .env.local TIDAK ikut ter-upload ke GitHub.
# =====================================================================

# --- Konfigurasi Firebase (Project settings > Your apps > Web) ---
NEXT_PUBLIC_FB_API_KEY=isi_dari_firebase
NEXT_PUBLIC_FB_AUTH_DOMAIN=namaproject.firebaseapp.com
NEXT_PUBLIC_FB_PROJECT_ID=namaproject
NEXT_PUBLIC_FB_STORAGE_BUCKET=namaproject.firebasestorage.app
NEXT_PUBLIC_FB_SENDER_ID=123456789012
NEXT_PUBLIC_FB_APP_ID=1:123456789012:web:abcdef123456

# --- Daftar email Super Admin (pisahkan dengan koma bila lebih dari satu) ---
NEXT_PUBLIC_ADMIN_EMAILS=syam.rakhmany@gmail.com

# --- Link Google Apps Script untuk upload foto ke Google Drive ---
# Isi setelah Apps Script di-deploy (lihat README bagian Upload Foto)
NEXT_PUBLIC_UPLOAD_URL=

# --- Identitas hotel (tampil di header & laporan) ---
NEXT_PUBLIC_HOTEL_NAME=Hotel Aston Cirebon
NEXT_PUBLIC_HOTEL_CODE=ACR
