rules_version = '2';

// =====================================================================
// FIRESTORE SECURITY RULES — Aston Cirebon Guest Laundry
//
// Ini adalah keamanan yang sesungguhnya. Menyembunyikan tombol di layar
// BUKAN keamanan; aturan di file inilah yang tidak bisa ditembus.
//
// Cara pasang:  Firebase Console → Firestore Database → Rules →
//               hapus isi lama, tempel semua isi file ini → Publish.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------
       FUNGSI BANTU
       --------------------------------------------------------------- */

    function masuk() {
      return request.auth != null;
    }

    function emailSaya() {
      return request.auth.token.email.lower();
    }

    // --- Daftar Super Admin BAWAAN ---------------------------------
    // Dipakai untuk "menyalakan" sistem pertama kali. Setelah ada satu
    // Super Admin di database, admin berikutnya cukup diberi peran lewat
    // menu Pengguna — tidak perlu mengubah file ini lagi.
    // Tambahkan email di sini HANYA untuk admin darurat/pemulihan.
    function superAdminBawaan() {
      return masuk() && emailSaya() in [
        'syam.rakhmany@gmail.com',
        'itm@astoncirebon.com'
      ];
    }

    function adaProfil() {
      return masuk() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profilAktif() {
      return adaProfil() && profil().active == true;
    }

    // Super Admin = email bawaan ATAU peran super_admin di database.
    function superAdmin() {
      return superAdminBawaan() || (profilAktif() && profil().role == 'super_admin');
    }

    function punyaPeran(daftar) {
      return superAdmin() || (profilAktif() && profil().role in daftar);
    }

    // Semua staf yang sudah diberi peran — TERMASUK super_admin & hk_leader.
    function stafAktif() {
      return punyaPeran([
        'valet', 'attendant', 'hk_supervisor', 'hk_leader', 'front_office', 'super_admin'
      ]);
    }

    function leader() {
      return punyaPeran(['hk_leader']);
    }

    /* ---------------------------------------------------------------
       PENGGUNA
       --------------------------------------------------------------- */
    match /users/{uid} {
      // Profil sendiri selalu boleh dibaca. Staf aktif boleh melihat daftar
      // pengguna (dipakai halaman Pengguna & penulisan nama di riwayat).
      allow read: if masuk() && (request.auth.uid == uid || stafAktif());

      // Login pertama: hanya boleh mendaftarkan diri sendiri, dan hanya
      // dengan peran "pending" — kecuali email yang memang Super Admin bawaan.
      allow create: if masuk() && request.auth.uid == uid
                    && (
                      request.resource.data.role == 'pending'
                      || (request.resource.data.role == 'super_admin' && superAdminBawaan())
                    );

      // Perubahan peran hanya oleh Super Admin.
      // Pengguna biasa boleh memperbarui profilnya sendiri asal peran
      // dan status aktifnya tidak berubah.
      allow update: if superAdmin()
                    || (masuk() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active);

      allow delete: if superAdmin();
    }

    /* ---------------------------------------------------------------
       NOTA LAUNDRY
       --------------------------------------------------------------- */
    match /laundry_orders/{orderId} {
      allow read: if stafAktif();

      allow create: if punyaPeran(['valet', 'hk_supervisor', 'hk_leader', 'front_office', 'super_admin']);

      // Nota terkunci tidak bisa diubah siapa pun kecuali Super Admin,
      // dan yang boleh mengunci hanya HK Leader / Super Admin.
      allow update: if stafAktif()
                    && (resource.data.isLocked != true || superAdmin())
                    && (request.resource.data.isLocked != true || leader() || superAdmin());

      allow delete: if superAdmin();
    }

    /* ---------------------------------------------------------------
       KENDALA
       --------------------------------------------------------------- */
    match /laundry_issues/{issueId} {
      allow read: if stafAktif();
      allow create: if stafAktif();
      allow update: if punyaPeran(['hk_leader', 'hk_supervisor', 'super_admin']);
      allow delete: if superAdmin();
    }

    /* ---------------------------------------------------------------
       MASTER DATA
       --------------------------------------------------------------- */
    match /price_list/{itemId} {
      allow read: if stafAktif();
      allow write: if superAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if stafAktif();
      allow write: if superAdmin();
    }

    match /app_settings/{docId} {
      allow read: if stafAktif();
      allow write: if superAdmin();
    }

    /* ---------------------------------------------------------------
       PENOMORAN & STATISTIK
       --------------------------------------------------------------- */
    match /counters/{docId} {
      allow read, write: if stafAktif();
    }

    match /daily_stats/{docId} {
      allow read, write: if stafAktif();
    }

    /* ---------------------------------------------------------------
       TUTUP SEMUA YANG TIDAK DISEBUT DI ATAS
       --------------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
